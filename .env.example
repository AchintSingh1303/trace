# Copy to .env to override defaults. Every value is optional for a local demo.

# SQLite file by default. Any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///data/trace.db

# Used to sign login tokens. Change this for anything beyond a local demo.
# SECRET_KEY=change-me

# Seed demo users and a sample project on first start (1 = yes, 0 = no).
# SEED_DEMO=1

# Artificial pause (ms) between streamed test cases so the live view is visible.
# GENERATION_DELAY_MS=120

# Optional server-wide generator defaults. People can also choose a provider and
# paste their own key in the Generate tab, which needs none of these.
#   LLM_PROVIDER: rules (default, offline) | anthropic (Claude) | openai (ChatGPT)
# LLM_PROVIDER=rules
# LLM_API_KEY=
# LLM_MODEL=

# --- Running for a team ---------------------------------------------------
# With SEED_DEMO=0 there are no demo accounts and SECRET_KEY must be changed.
# SEED_DEMO=0
# SECRET_KEY=a-long-random-string
# The first admin, created on start when there are no users yet. Add everyone else in the Team tab.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-something-long
